#include <avr/io.h>
#include <util/delay.h>
#include <avr/interrupt.h>

#define clk_x PB3
#define dir_x PB4
#define en_x PB5
#define clk_y PC3
#define dir_y PC4
#define en_y PC5
#define SOL PC0



void pwm_motor_x() {
	DDRB |= (1 << clk_x) | (1 << dir_x) | (1 << en_x);

	TCCR2A |= (1 << COM2A0) | (1 << WGM21) | (1 << WGM20);
	TCCR2B |= (1 << WGM22);
	TCCR2B |= (1 << CS21);

	OCR2A = 128;
}

void motor_x_velocidad(uint8_t velocidad) {
	OCR2A = velocidad;
}

void pwm_motor_y() {
	DDRC |= (1 << clk_y) | (1 << dir_y) | (1 << en_y) | (1 << SOL);

	TCCR1A = 0;
	TCCR1B |= (1 << WGM12);
	TCCR1B |= (1 << CS11);

	OCR1A = 128;

	TIMSK1 |= (1 << OCIE1A);
	
}



void motor_y_velocidad(uint8_t velocidad) {
	OCR1A = velocidad;
	sei();
}

ISR(TIMER1_COMPA_vect) {
	PORTC ^= (1 << clk_y);
}

void mover_abajo() {
	PORTB |= (1 << dir_x) | (1 << en_x);
}

void mover_arriba() {
	PORTB |= (1 << en_x);
	PORTB &= ~(1 << dir_x);
}

void detener() {
	PORTB &= ~((1 << en_x) | (1 << dir_x));
	PORTC &= ~((1 << en_y) | (1 << dir_y));
}

void mover_izquierda() {
	PORTC |= (1 << en_y);
	PORTC &= ~(1 << dir_y);
}

void mover_derecha() {
	PORTC |= (1 << dir_y) | (1 << en_y);
}

void subir_lapiz() {
	PORTC |= (1 << SOL);
}

void bajar_lapiz() {
	PORTC &= ~(1 << SOL);
}

void cruz() {
	bajar_lapiz();
	mover_derecha();
	_delay_ms(1000);
	mover_izquierda();
	_delay_ms(500);
	detener();
	mover_arriba();
	_delay_ms(500);
	mover_abajo();
	_delay_ms(1000);
	detener();
	subir_lapiz();
}

void triangulo() {
	bajar_lapiz();
	mover_derecha();
	_delay_ms(1000);
	mover_izquierda();
	mover_arriba();
	_delay_ms(500);
	mover_abajo();
	_delay_ms(500);
	detener();
	subir_lapiz();
	
}

void circulo() {
	bajar_lapiz();
	mover_derecha();
	mover_abajo();
	int velocidad = 128;
	motor_x_velocidad(velocidad);
	motor_y_velocidad(129 - velocidad);
	while (velocidad > 10) {
		velocidad -= 10;
		motor_y_velocidad(129 - velocidad + 20);
		_delay_ms(100);
	}
	velocidad = 128;
	while (velocidad > 10) {
		velocidad -= 10;
		motor_x_velocidad(velocidad);
		_delay_ms(50);
	}
	velocidad = 128;
	mover_izquierda();
	motor_y_velocidad(velocidad);
	motor_x_velocidad(129 - velocidad);
	while (velocidad > 10) {
		velocidad -= 10;
		motor_x_velocidad(129 - velocidad);
		_delay_ms(100);
	}
	velocidad = 128;
	while (velocidad > 10) {
		velocidad -= 10;
		motor_y_velocidad(velocidad + 20);
		_delay_ms(50);
	}
	velocidad = 128;
	mover_arriba();
	motor_x_velocidad(velocidad);
	motor_y_velocidad(129 - velocidad);
	while (velocidad > 10) {
		velocidad -= 10;
		motor_y_velocidad(129 - velocidad + 30);
		_delay_ms(100);
	}
	velocidad = 128;
	while (velocidad > 10) {
		velocidad -= 10;
		motor_x_velocidad(velocidad);
		_delay_ms(50);
	}
	velocidad = 128;
	mover_derecha();
	motor_y_velocidad(velocidad);
	motor_x_velocidad(129 - velocidad);
	while (velocidad > 10) {
		velocidad -= 10;
		motor_x_velocidad(129 - velocidad + 10);
		_delay_ms(100);
	}
	velocidad = 128;
	while (velocidad > 10) {
		velocidad -= 10;
		motor_y_velocidad(velocidad + 20);
		_delay_ms(50);
	}
	//motor_x_velocidad(128);
	//motor_y_velocidad(128);
	//_delay_ms(500);
	detener();
	subir_lapiz();
}



int main(void) {
	subir_lapiz();
	pwm_motor_x();
	pwm_motor_y();
	motor_x_velocidad(128);
	motor_y_velocidad(128);
	cruz();
	triangulo();
	circulo();
	

	while (1) {
		motor_x_velocidad(128);
		motor_y_velocidad(128);
		
	}
	
	return 0;
}
